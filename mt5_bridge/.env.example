# Render FastAPI backend URL, with no trailing slash
TRADEGRID_API_BASE_URL=https://trading-intelligence-backend.onrender.com
# UUID of the account created in the dashboard
TRADEGRID_ACCOUNT_ID=replace-with-account-uuid
# One-time token returned by the connector-tokens endpoint; never commit the real value
TRADEGRID_CONNECTOR_TOKEN=replace-with-one-time-token
# Optional full path to terminal64.exe
MT5_TERMINAL_PATH=
MT5_INITIAL_LOOKBACK_DAYS=10000
MT5_HISTORY_CHUNK_DAYS=90
MT5_SYNC_OVERLAP_DAYS=2
MT5_SYNC_STATE_PATH=.tradegrid_sync_state.json
MT5_POLL_SECONDS=60
MT5_BATCH_SIZE=250
LOG_LEVEL=INFO
