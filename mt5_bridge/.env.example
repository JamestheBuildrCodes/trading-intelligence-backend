# URL of the deployed FastAPI backend, without a trailing slash
TRADEGRID_API_BASE_URL=https://trading-intelligence-backend.onrender.com
# Account UUID created in TradeGrid
TRADEGRID_ACCOUNT_ID=replace-with-account-uuid
# One-time connector token generated by POST /api/v1/accounts/{id}/connector-tokens
TRADEGRID_CONNECTOR_TOKEN=replace-with-one-time-token
# Optional path to terminal64.exe. Leave blank to use the currently installed terminal.
MT5_TERMINAL_PATH=
# Initial history lookback on first run; later polls re-read a short overlap window safely.
MT5_INITIAL_LOOKBACK_DAYS=30
MT5_POLL_SECONDS=60
MT5_BATCH_SIZE=250
