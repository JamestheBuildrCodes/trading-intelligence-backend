# Server-only Supabase credentials. Never put this key in the frontend or source control.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_this_with_your_server_key

# Legacy fallback for projects not yet migrated to new keys:
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key

# Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
# Keep this value stable; changing it invalidates all previously issued connector tokens.
CONNECTOR_TOKEN_PEPPER=replace-with-a-long-random-secret
AI_DAILY_BUDGET_USD=1.0
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR-VERCEL-DOMAIN.vercel.app

# Optional hosted MT5 provider token from https://app.metaapi.cloud/token
# Leave unset to disable hosted cloud provisioning.
METAAPI_TOKEN=
# Temporary beta override allowing hosted MT5 on Free/Trader plans; disable after beta.
HOSTED_MT5_BETA_ENABLED=false

# Optional billing setup. Leave blank to keep checkout disabled.
PAYSTACK_SECRET_KEY=
PAYSTACK_TRADER_MONTHLY_PLAN_CODE=
PAYSTACK_TRADER_YEARLY_PLAN_CODE=
PAYSTACK_PRO_MONTHLY_PLAN_CODE=
PAYSTACK_PRO_YEARLY_PLAN_CODE=
APP_BASE_URL=https://tradvoryx.vercel.app
